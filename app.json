{
  "expo": {
    "name": "Sunday Sort",
    "slug": "sundaysort",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sundaysort",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.phiotron.sundaysort",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.phiotron.sundaysort"
        ]
      }
    },
    "android": {
      "package": "com.phiotron.sundaysort",
      "adaptiveIcon": {
        "backgroundColor": "#1F2A44",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#12161C"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sunday Sort uses your location to record the route of each trip and work out your mileage. Your routes stay on your phone.",
          "locationAlwaysAndWhenInUsePermission": "Choose Always Allow so Sunday Sort can record your drives automatically, even when the app is closed or the screen is off. It notices when you leave a parking spot and starts recording on its own. If you choose While Using, trips only record while the app is open. Your routes stay on your phone.",
          "locationAlwaysPermission": "Choose Always Allow so Sunday Sort can record your drives automatically, even when the app is closed or the screen is off. It notices when you leave a parking spot and starts recording on its own. If you choose While Using, trips only record while the app is open. Your routes stay on your phone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidMotionActivityEnabled": true,
          "motionUsagePermission": "Sunday Sort uses motion and fitness activity to tell when you start and stop driving, so trips record on their own and walks aren't counted. Motion data stays on your phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Sunday Sort uses the camera to photograph receipts. Photos stay on your phone.",
          "photosPermission": "Pick a receipt photo from your library. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Sunday Sort with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5B841"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
              "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
              "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
              "./node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-quick-actions",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SundayQuick",
              "label": "Quick add",
              "description": "Add an expense or income in one tap.",
              "previewImage": "./assets/widgets/quick-preview.png",
              "minWidth": "110dp",
              "minHeight": "50dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SundayWeek",
              "label": "Week & trip",
              "description": "This week's net, entries to sort and a trip button.",
              "previewImage": "./assets/widgets/week-preview.png",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withReleasePermissions",
      "expo-iap",
      "./plugins/withNfcTripTag",
      "expo-background-task",
      "./plugins/withWorkManagerSafeInit",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "27d20460-7185-4470-a788-e92de8b04103"
      }
    },
    "owner": "phamthuphuong"
  }
}
